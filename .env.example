PORT=3333
NODE_ENV=development

# Preenchido a partir de packages/database (.env) — mesma connection string
DATABASE_URL="mysql://user:password@localhost:3306/fraternidade"

JWT_SECRET="change-me"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Host público usado para montar as URLs de /uploads gravadas no banco.
# Em produção precisa ser o domínio real — se ficar vazio, as URLs saem como
# http://localhost:3333/uploads/... e só funcionam na máquina que as gerou.
PUBLIC_API_URL="http://localhost:3333"
